<FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="@HorizontalGap" Style="@Style">
    @ChildContent
</FluentStack>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? HorizontalGap { get; set; } = "5px";

    [Parameter]
    public string? Style { get; set; } = $"margin-bottom: 3px;";
}
