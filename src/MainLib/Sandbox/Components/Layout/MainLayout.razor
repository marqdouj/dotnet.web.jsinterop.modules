@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />
        <FluentText Weight="TextWeight.Bold" Size="TextSize.Size600">Sandbox</FluentText>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Class="main">
        <div class="content" style="height: 100%;">
            @Body
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer">
        <div style="display: flex">
            <FluentLink Href="https://www.fluentui-blazor.net" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                Fluent UI Blazor
            </FluentLink>
            <FluentSpacer />
            <FluentLink Href="https://github.com/marqdouj" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                &copy; Doug Marquardt @DateTime.Now.Year
            </FluentLink>
            <FluentSpacer />
            <FluentLink Href="https://learn.microsoft.com/en-us/aspnet/core/blazor" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                About Blazor
            </FluentLink>
        </div>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
